#!/bin/sh
# systemd-sleep hook: $1 = pre|post, $2 = suspend|hibernate|hybrid-sleep|suspend-then-hibernate
case $1 in
    pre)
        /usr/lib/halcyon/wifi-resume save
        /usr/lib/halcyon/wifi-resume unload
        ;;
    post)
        # Check in the background: NetworkManager only wakes up once this hook returns.
        systemd-run --no-block --collect --unit="halcyon-wifi-resume-$$" \
            /usr/lib/halcyon/wifi-resume check
        ;;
esac
