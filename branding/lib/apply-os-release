#!/bin/sh
# Rebrand os-release. Re-run by a pacman hook whenever 'filesystem' updates it.
# CachyOS-based installs say so in ID_LIKE (CachyOS tools look for it).
like=arch
grep -q '^\[cachyos\]' /etc/pacman.conf 2>/dev/null && like="cachyos arch"
cat > /usr/lib/os-release <<EOR
NAME="Halcyon Linux"
PRETTY_NAME="Halcyon Linux"
ID=halcyon
ID_LIKE="$like"
BUILD_ID=rolling
ANSI_COLOR="38;2;30;155;224"
LOGO=halcyon-logo
DOCUMENTATION_URL="https://wiki.archlinux.org/"
EOR
