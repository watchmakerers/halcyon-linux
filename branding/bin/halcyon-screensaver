#!/usr/bin/env bash
# Halcyon screensavers: the built-in "Bubbles" scene, or classic Windows
# screensavers (.scr, e.g. from Microsoft Plus!) run through Wine.
#
#   halcyon-screensaver              start the chosen screensaver now
#   halcyon-screensaver --settings   choose a screensaver and the idle time
#   halcyon-screensaver --daemon     idle watcher (started at login)
#   halcyon-screensaver --run SAVER  run a specific saver ("bubbles" or a .scr path)
set -uo pipefail

PREFIX=${HALCYON_WINEPREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/halcyon/windows}
EXTRA=${XDG_DATA_HOME:-$HOME/.local/share}/halcyon/screensavers
SHARE=/usr/share/halcyon/screensaver
NOSLEEP="systemd-inhibit --what=sleep --mode=block --who=Halcyon-screensaver --why=Screensaver-showing"
cfg() { kreadconfig6 --file halcyonrc --group Screensaver --key "$1" --default "$2"; }

running() { pgrep -if "$SHARE/screensaver.qml|^[A-Za-z]:.*\.scr /s$" >/dev/null; }

run_saver() {
    local saver=$1
    running && return 0
    # systemd-inhibit: the PC doesn't go to sleep while a screensaver is showing
    # (the screen still locks on schedule).
    if [[ $saver == bubbles || ! -f $saver ]]; then
        exec $NOSLEEP /usr/lib/qt6/bin/qml "$SHARE/screensaver.qml"
    fi
    # Windows screensaver: "/s" runs it fullscreen; it exits on mouse/keys itself.
    command -v wine >/dev/null || exec "$0" --run bubbles
    export WINEPREFIX=$PREFIX WINEDEBUG=-all
    (( $(monitors | wc -l) > 1 )) && exec $NOSLEEP "$0" --span "$saver"
    exec $NOSLEEP wine "$saver" /s
}

monitors() {  # "WIDTHxHEIGHT" per monitor, left to right
    xrandr --listmonitors 2>/dev/null |
        sed -nE 's#^ *[0-9]+: +[^ ]+ ([0-9]+)/[0-9]+x([0-9]+)/[0-9]+\+(-?[0-9]+)\+(-?[0-9]+).*#\3 \4 \1x\2#p' |
        sort -n -k1,1 -k2,2 | awk '{print $3}'
}

span_saver() {
    # Plus! and other DirectX screensavers draw only on the main monitor and
    # black out the rest. Give each monitor its own copy, each in a Wine
    # desktop the size of that monitor, which KWin (span.js) puts fullscreen
    # on it. When one copy exits (mouse or keys), the others are closed.
    local saver=$1 win i=0 n t size pat
    win=$(winepath -w "$saver" 2>/dev/null) || win=$saver
    # Windows processes show their command line as "C:\...\name.scr /s".
    pat="^[A-Za-z]:.*[\\/]${win##*[\\/]} /s"
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript halcyon-saver-span >/dev/null 2>&1
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$SHARE/span.js" halcyon-saver-span >/dev/null 2>&1 &&
        qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null 2>&1
    # Open and place the empty desktops first: a window moved after the saver
    # starts counts as mouse movement and the saver quits.
    while read -r size; do
        wine explorer /desktop="HalcyonSaver$i,$size" >/dev/null 2>&1 &
        i=$((i + 1))
    done < <(monitors)
    sleep 2
    for ((n = 0; n < i; n++)); do
        wine explorer /desktop="HalcyonSaver$n" "$win" /s >/dev/null 2>&1 &
    done
    # Wait for the copies to start, then until any one of them exits.
    for ((t = 0; t < 40 && $(pgrep -fc "$pat") < i; t++)); do sleep 0.25; done
    while (( $(pgrep -fc "$pat") >= i )); do sleep 0.25; done
    pkill -f "$pat" 2>/dev/null
    pkill -f "^[A-Za-z]:.*explorer.exe /desktop=HalcyonSaver" 2>/dev/null
    wait
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript halcyon-saver-span >/dev/null 2>&1
}

list_savers() {  # "path<TAB>name" for every .scr we can find
    printf 'bubbles\tBubbles (Halcyon)\n'
    { [[ -d $PREFIX/drive_c ]] && find "$PREFIX/drive_c" -iname '*.scr' -size +1k 2>/dev/null
      [[ -d $EXTRA ]] && find "$EXTRA" -iname '*.scr' 2>/dev/null; } |
    while IFS= read -r f; do
        n=$(basename "$f"); printf '%s\t%s\n' "$f" "${n%.*}"
    done | sort -t$'\t' -k2 -f | awk -F'\t' '!seen[tolower($2)]++'
}

case ${1:-} in
    --run) run_saver "${2:-bubbles}" ;;
    --span) span_saver "$2" ;;
    --daemon)
        # swayidle uses Wayland's idle protocol, which KWin supports and which
        # respects "don't sleep" requests from video players.
        [[ $(cfg Enabled true) == true ]] || exit 0
        mins=$(cfg Timeout 3)
        exec swayidle -w timeout $(( mins * 60 )) "$0 --run '$(cfg Saver bubbles)'"
        ;;
    --settings)
        export HALCYON_SS_LIST HALCYON_SS_CURRENT HALCYON_SS_TIMEOUT HALCYON_SS_ENABLED HALCYON_SS_PREFIX
        HALCYON_SS_LIST=$(list_savers)
        HALCYON_SS_CURRENT=$(cfg Saver bubbles)
        HALCYON_SS_TIMEOUT=$(cfg Timeout 3)
        HALCYON_SS_ENABLED=$(cfg Enabled true)
        HALCYON_SS_PREFIX=$PREFIX
        QML_XHR_ALLOW_FILE_READ=1 exec /usr/lib/qt6/bin/qml "$SHARE/settings.qml"
        ;;
    --restart-daemon)
        pkill -f "swayidle .*halcyon-screensaver" 2>/dev/null
        setsid -f "$0" --daemon >/dev/null 2>&1
        ;;
    --add)
        # Copy a .scr (and the files next to it) into ~/.local/share/halcyon/screensavers.
        src=$(kdialog --getopenfilename "$HOME" "*.scr *.SCR|Windows screensavers") || exit 0
        dest=$EXTRA/$(basename "${src%.*}")
        mkdir -p "$dest" && cp -r "$(dirname "$src")"/. "$dest"/
        kdialog --passivepopup "Added $(basename "$src")" 3
        ;;
    "") run_saver "$(cfg Saver bubbles)" ;;
    *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
