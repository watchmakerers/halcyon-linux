#!/usr/bin/env bash
# Switch the running Plasma session between Halcyon's two desktop modes,
# live, without logging out.
#
#   halcyon-mode classic   floating glass windows, taskbar docked along the bottom
#   halcyon-mode tiling    Hyprland-style: auto-tiling, gaps, borderless
#                          windows with a glowing edge, slim bar on top
#   halcyon-mode toggle    switch to the other one
#   halcyon-mode bar       show/hide the panel (tiling-mode Super+Shift+Space)
#   halcyon-mode float [MONITOR...]
#                          in tiling mode, leave these monitors floating
#                          (connector names, e.g. HDMI-A-1); no names = tile all
#   halcyon-mode status    print the current mode
set -euo pipefail

cfg() { kwriteconfig6 "$@"; }
get() { kreadconfig6 "$@"; }

dbus() {  # dbus <dest> <path> <method> [args...]
    dbus-send --session --print-reply=literal --dest="$1" "$2" "$3" "${@:4}"
}

# A panel that can't be moved (plasmashell restarting) must not abort the switch half-way.
plasma_js() {
    dbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "string:$1" >/dev/null ||
        echo "halcyon-mode: could not update the panel" >&2
}

notify() {
    command -v kdialog >/dev/null && kdialog --title "Halcyon" --icon halcyon-logo --passivepopup "$1" 3 &
}

script_loaded() {
    dbus org.kde.KWin /Scripting org.kde.kwin.Scripting.isScriptLoaded string:krohnkite | grep -q true
}

kwin_js() {  # kwin_js <code>: run a one-shot KWin script
    local f id
    f=$(mktemp --suffix=.js)
    printf '%s\n' "$1" >"$f"
    id=$(dbus org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript string:"$f" string:halcyon-oneshot | awk '{print $NF}')
    dbus org.kde.KWin /Scripting/Script"$id" org.kde.kwin.Script.run >/dev/null
    sleep 0.2
    dbus org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript string:halcyon-oneshot >/dev/null || true
    rm -f "$f"
}

current() { get --file halcyonrc --group Mode --key current --default classic; }

# Monitors that stay floating in tiling mode, comma-separated connector names.
float_screens() { get --file halcyonrc --group Mode --key floatScreens --default ""; }

# Panel placement per mode (Plasma script, acting on panel p).
PANEL_CLASSIC="p.location = 'bottom'; p.height = Math.round(gridUnit * 2.1); p.floating = false; p.lengthMode = 'fill'; p.hiding = 'none';"
PANEL_TILING="p.location = 'top'; p.height = Math.round(gridUnit * 1.6); p.floating = true; p.hiding = 'none';
    if (p.widgets().length == p.widgets('org.halcyon.workspaces').length) { p.lengthMode = 'fit'; p.alignment = 'center'; }"

# Top-left corners ("x,y") of the floating monitors, to find their panels:
# Plasma's scripting API knows a panel's screen geometry, not its connector name.
float_corners() {
    local floats; floats=$(float_screens)
    [[ -n $floats ]] || return 0
    kscreen-doctor -j 2>/dev/null | FLOATS=$floats python3 -I -c '
import json, os, sys
names = set(os.environ["FLOATS"].split(","))
for o in json.load(sys.stdin)["outputs"]:
    if o.get("enabled") and o["name"] in names:
        print("%d,%d" % (o["pos"]["x"], o["pos"]["y"]))'
}

# Hand windows back from Krohnkite: it puts tiled windows on the keep-below
# layer and, with noTileBorder, strips their borders.
release_windows() {
    local borders=""
    [[ $(get --file kwinrc --group Script-krohnkite --key noTileBorder --default false) == true ]] &&
        borders="w.noBorder = false;"
    kwin_js "workspace.windowList().forEach(function (w) { if (w.normalWindow && w.keepBelow) { w.keepBelow = false; $borders } });" || true
}

set_desktops() {  # set_desktops N: grow/shrink virtual desktops to N
    local want=$1 have ids
    have=$(dbus org.kde.KWin /VirtualDesktopManager org.freedesktop.DBus.Properties.Get \
        string:org.kde.KWin.VirtualDesktopManager string:count | awk '{print $NF}')
    while (( have < want )); do
        dbus org.kde.KWin /VirtualDesktopManager org.kde.KWin.VirtualDesktopManager.createDesktop \
            uint32:"$have" string:"Workspace $((have + 1))" >/dev/null
        have=$((have + 1))
    done
    if (( have > want )); then
        # Desktop ids, in order; remove from the end. KWin moves their windows.
        mapfile -t ids < <(dbus org.kde.KWin /VirtualDesktopManager org.freedesktop.DBus.Properties.Get \
            string:org.kde.KWin.VirtualDesktopManager string:desktops |
            grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | awk '!s[$0]++')
        for ((i = ${#ids[@]} - 1; i >= want; i--)); do
            dbus org.kde.KWin /VirtualDesktopManager org.kde.KWin.VirtualDesktopManager.removeDesktop \
                string:"${ids[i]}" >/dev/null
        done
    fi
}

# Window border for a mode, recoloured if a window color is in use (halcyon-colors).
deco() {
    if [[ -d ${XDG_DATA_HOME:-$HOME/.local/share}/aurorae/themes/${1}Tinted ]] &&
       [[ $(kreadconfig6 --file plasmarc --group Theme --key name) == Halcyon-Tinted ]]; then
        echo "__aurorae__svg__${1}Tinted"
    else
        echo "__aurorae__svg__$1"
    fi
}

# Rounded window corners (kwin-effect-rounded-corners), on in tiling mode only:
# classic mode's Aero frames already have their own rounded tops.
CORNERS=kwin4_effect_shapecorners
corners() {  # corners true|false
    cfg --file kwinrc --group Plugins --key "${CORNERS}Enabled" "$1"
    if [[ $1 == true ]]; then
        dbus org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect "string:$CORNERS" >/dev/null 2>&1 || true
    else
        dbus org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect "string:$CORNERS" >/dev/null 2>&1 || true
    fi
}

tiling() {
    cfg --file halcyonrc --group Mode --key current tiling
    corners true
    cfg --file kwinrc --group Plugins --key krohnkiteEnabled true
    cfg --file kwinrc --group Script-krohnkite --key screenGapTop 8
    cfg --file kwinrc --group Script-krohnkite --key screenGapBottom 8
    cfg --file kwinrc --group Script-krohnkite --key screenGapLeft 8
    cfg --file kwinrc --group Script-krohnkite --key screenGapRight 8
    cfg --file kwinrc --group Script-krohnkite --key screenGapBetween 8
    cfg --file kwinrc --group Script-krohnkite --key soleWindowNoGaps false
    local floats; floats=$(float_screens)
    cfg --file kwinrc --group Script-krohnkite --key ignoreScreen "$floats"
    if [[ -n $floats ]]; then
        # The window theme is global, and the slim one has no title bar: floating
        # monitors keep the classic theme, tiled windows go borderless instead.
        cfg --file kwinrc --group Script-krohnkite --key noTileBorder true
        cfg --file kwinrc --group org.kde.kdecoration2 --key theme "$(deco HalcyonAero)"
        cfg --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft M
        cfg --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight IAX
    else
        cfg --file kwinrc --group Script-krohnkite --key noTileBorder false
        cfg --file kwinrc --group org.kde.kdecoration2 --key theme "$(deco HalcyonAeroSlim)"
        cfg --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft ""
        cfg --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight ""
    fi
    dbus org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null
    # Enabling the plugin in kwinrc isn't enough: ask KWin to load enabled scripts.
    dbus org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null
    sleep 0.3
    if ! script_loaded; then
        notify "Tiling failed: KWin could not load Krohnkite (see: journalctl --user -b | grep -i krohnkite)"
        echo "Krohnkite did not load." >&2
    fi
    set_desktops "$(get --file halcyonrc --group Mode --key workspaces --default 10)"  # tiling-mode workspace count
    # Floating monitors keep the classic taskbar; tiled ones get the slim top bar.
    local corners; corners=$(float_corners | sed "s/.*/'&'/" | paste -sd,)
    plasma_js "var floats = [$corners]; panels().forEach(function (p) { var g = screenGeometry(p.screen); if (floats.indexOf(g.x + ',' + g.y) >= 0) { $PANEL_CLASSIC } else { $PANEL_TILING } })"
    notify "Tiling mode: Super+Ctrl+Alt+Space to go back"
}

classic() {
    cfg --file halcyonrc --group Mode --key current classic
    corners false
    cfg --file kwinrc --group Plugins --key krohnkiteEnabled false
    dbus org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript string:krohnkite >/dev/null || true
    release_windows
    cfg --file kwinrc --group org.kde.kdecoration2 --key theme "$(deco HalcyonAero)"
    cfg --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft M
    cfg --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight IAX
    dbus org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null
    set_desktops 4
    plasma_js "panels().forEach(function (p) { $PANEL_CLASSIC })"
    notify "Classic mode"
}

case ${1:-toggle} in
    tiling)  tiling ;;
    classic) classic ;;
    toggle)  if [[ $(current) == tiling ]]; then classic; else tiling; fi ;;
    float)
        floats=$(IFS=,; echo "${*:2}")
        cfg --file halcyonrc --group Mode --key floatScreens "$floats"
        if [[ $(current) == tiling ]]; then
            # Krohnkite reads its settings only when it loads: restart it.
            dbus org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript string:krohnkite >/dev/null || true
            release_windows
            tiling
        fi
        echo "floating monitors: ${floats:-none}"
        ;;
    bar)     plasma_js "panels().forEach(function (p) { p.hiding = (p.hiding == 'none') ? 'autohide' : 'none'; })" ;;
    status)  echo "mode: $(current)"; echo "floating monitors: $(float_screens)"; script_loaded && echo "krohnkite: loaded" || echo "krohnkite: not loaded" ;;
    *)       echo "usage: halcyon-mode classic|tiling|toggle|float [MONITOR...]|bar|status" >&2; exit 2 ;;
esac
